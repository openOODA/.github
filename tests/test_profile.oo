// # .github Verification Suite
//
// Logline: Positive and negative-trust assertions over the canonical post-quantum round that seals org-profile digests.
//
// Setup: Pure functions over integers. No IO beyond the read capability.
//
// Beats:
//   1. Assert the seal round is deterministic and positive.
//   2. Assert a tampered nonce changes the seal.
//   3. Assert a forged digest fails closed.

import "oostd/sec/pqc.oo";

fn expect(cond: Bool, label: String) -> Bool {
    if cond {
        println("ok " + label);
        return true;
    }
    println("FAIL " + label);
    return false;
}

pub fn main(
    fs_r: &FsReadCap,
    args: List[String]
) -> Result[Int, String] {
    let mut p: Int = 0;
    if expect(oo_pqc_sha3_round(41, 7) == oo_pqc_sha3_round(41, 7), "01 seal round is deterministic") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) > 0, "02 seal stays in the positive field") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(41, 8), "03 tampered nonce yields a different seal") { p = p + 1; }
    if expect(oo_pqc_sha3_round(0, 7) != oo_pqc_sha3_round(41, 7), "04 forged digest yields a different seal") { p = p + 1; }
    if expect(oo_pqc_sha3_round(0, 0) != oo_pqc_sha3_round(41, 7), "05 degenerate seal differs from honest") { p = p + 1; }
    if expect(oo_pqc_sha3_round(0 - 1, 7) != oo_pqc_sha3_round(41, 7), "06 negative digest differs") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 0 - 1) != oo_pqc_sha3_round(41, 7), "07 negative nonce differs") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(42, 7), "08 one-step digest drift differs") { p = p + 1; }
    if expect(oo_pqc_sha3_round(100000007, 7) > 0, "09 large-input seal stays positive") { p = p + 1; }
    let big: Int = oo_pqc_sha3_round(100000007, 7);
    if expect(big == oo_pqc_sha3_round(100000007, 7), "10 large round is deterministic") { p = p + 1; }
    if p == 10 {
        println("github tests: 10/10 passed");
        return Ok(0);
    }
    println("github tests: FAILED (" + to_string(p) + "/10)");
    return Ok(1);
}
