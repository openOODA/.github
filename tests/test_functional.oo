// # .github Functional Suite - Positive-Trust Assertions
//
// Logline: Positive assertions over the repository's compilable no-main .oo linguist
//          samples AND the org-metadata conformance checkers.
// Setup: Imports the sample set, the canonical CapReg64 primitives it wraps, and the
//        meta_check/meta_law pages; FsReadCap for the bounded sample + profile reads.
// Beats:
//   1. The fail-closed gate admits a valid register and computes the sector offset.
//   2. The attenuated child register keeps FsRead and drops FsWrite exactly as declared.
//   3. Census, repo counts, org links, layer members, and the 11-entry root all hold.

import "linguist/samples/OODA/capreg_attenuation.oo";
import "linguist/samples/OODA/typestate_machine.oo";
import "linguist/samples/OODA/smt_contracts.oo";
import "oostd/sec/capreg.oo";
import "core/meta_check.oo";
import "core/meta_law.oo";

fn t_expect(cond: Bool, label: String, p: Int) -> Int {
    if cond {
        println("ok " + label);
        return p + 1;
    }
    println("FAIL " + label);
    return p;
}

fn t_samples(fs: &FsReadCap) -> Int {
    let mut p: Int = 0;
    let fsr: Int = 1 << oo_cap_bit_index("FsReadCap");
    let fsw: Int = 1 << oo_cap_bit_index("FsWriteCap");
    let reg64: Int = oo_cap_reg64_pack(7, 1, 1, fsr);
    p = t_expect(read_sector_gated(reg64, 7, 4) == 2048, "gated sector read", p);
    let child: Int = child_register(oo_cap_reg64_pack(7, 255, 1, fsr | fsw), 9);
    p = t_expect(oo_cap_reg64_check(child, 7, 1, fsr) &&
        oo_cap_reg64_check(child, 7, 1, fsw) == false, "child keeps read drops write", p);
    p = t_expect(floor_div(17, 5) == 3 && gcd(12, 18) == 6 && clamp(9, 0, 5) == 5,
        "contracted arithmetic", p);
    p = t_expect(checked_div(8, 2).is_ok() && drive_link() == 18, "div ok + link walk", p);
    let page: Result[String, String] = oo_read_file(fs, "linguist/samples/OODA/capreg_attenuation.oo");
    p = t_expect(page.is_ok(), "sample page readable under jail", p);
    return p;
}

fn t_meta(fs: &FsReadCap) -> Int {
    let mut p: Int = 0;
    let zsrc: String = "| `5` | `8` | `9` | `39` | `16` | `97` `105` `110`" +
        " ooagent-hud +ooquota";
    p = t_expect(meta_counts(zsrc) == 5 && meta_census(zsrc) == 5,
        "count cells + census needles", p);
    let osrc: String = "github.com/openOODA) github.com/openOODA-core)" +
        " github.com/openOODA-kernel) github.com/openOODA-OS)" +
        " github.com/openOODA-tools) github.com/openOODA-DE)" +
        " github.com/openOODA-apps) github.com/openOODA-cloud)" +
        " github.com/openOODA-agents)";
    p = t_expect(meta_orgs(osrc) == 9, "nine org links", p);
    p = t_expect(meta_members("oodac ookernel ooinit ootheme oocomp oobrowser " +
        "oomesh ooloop oobench") == 9, "nine layer members", p);
    p = t_expect(meta_ver_num("2.11.7") >= 0 && meta_ver_num("0.0.1") == 1,
        "semver parses", p);
    p = t_expect(meta_shape("# t\nl1\nl2\nl3\nl4\nl5\nl6\nl7\n") &&
        meta_title_ok("# .github (openOODA) x Organization Profile\n"),
        "page shape + canonical title", p);
    p = t_expect(meta_profile_ok(fs) && meta_repo_ok(fs),
        "profile + repo verdict holds", p);
    return p;
}

pub fn main(fs: &FsReadCap, _args: List[String]) -> Result[Int, String] {
    let p: Int = t_samples(fs) + t_meta(fs);
    if p == 11 {
        println("PASS: functional suite (11/11 assertions)");
        return Ok(0);
    }
    println("FAIL: functional suite (" + p.to_string() + "/11 assertions)");
    return Ok(2);
}
