// # Linguist Package & Sample Corpus Verifier
//
// Logline: Pure-.oo replacement for validate.py validating languages.yml, TextMate JSON/regexes,
//   heuristics rules, .gitattributes, Page Rule, and ooda-compiler check across samples/OODA/.
// Setup: Imports ooda-standard str/json/fs helpers; &FsReadCap, &ProcessCap, and &EnvCap bound checks.
// Beats:
//   1. Parse grammars/oo.tmLanguage.json via jzc_scan_value and check regex bracket/escape balance.
//   2. Verify languages.yml, heuristics.yml, and .gitattributes wire OODA (.oo / .oot) cleanly.
//   3. Enforce 10-rule heuristic coverage, 16..256 Page Rule, and ooda-compiler check over all samples.

import "ooda-standard/core/encoding/json_zero_copy.oo";

fn lv_regex_ok(src: String) -> Bool {
    let ls: List[String] = str_split(src, "\n");
    let mut i: Int = 0;
    let mut rx_cnt: Int = 0;
    while i < list_len(ls) {
        let ln: String = str_trim(list_get(ls, i));
        let col: Int = str_index_of(ln, ": \"");
        let is_rx: Bool = col > 0 && (str_starts_with(ln, "\"match\":") ||
            str_starts_with(ln, "\"begin\":") || str_starts_with(ln, "\"end\":"));
        i = i + 1;
        if !is_rx { continue; }
        rx_cnt = rx_cnt + 1;
        let mut paren: Int = 0;
        let mut brack: Int = 0;
        let mut r_esc: Bool = false;
        let mut j_esc: Bool = false;
        let mut j: Int = col + 3;
        while j < chars_len(ln) {
            let c: String = char_at(ln, j);
            j = j + 1;
            if !j_esc && c == "\"" { break; }
            let mut adv: Bool = true;
            if !j_esc && c == "\\" {
                j_esc = true;
                adv = false;
            } else {
                j_esc = false;
            }
            if adv && r_esc { r_esc = false; }
            else if adv && c == "\\" { r_esc = true; }
            else if adv && c == "[" && brack == 0 { brack = 1; }
            else if adv && c == "]" && brack == 1 { brack = 0; }
            else if adv && brack == 0 && c == "(" { paren = paren + 1; }
            else if adv && brack == 0 && c == ")" { paren = paren - 1; }
            if paren < 0 { return false; }
        }
        if j_esc || r_esc || paren != 0 || brack != 0 { return false; }
    }
    return rx_cnt > 0;
}

fn lv_check_configs(fs_r: &FsReadCap, root: String) -> Int {
    let lr: Result[String, String] = oo_read_file(fs_r, root + "/linguist/languages.yml");
    let lt: String = match lr { Ok(s) => s, Err(_) => "" };
    if !str_contains(lt, "OODA:") || !str_contains(lt, "\".oo\"") ||
        !str_contains(lt, "\".oot\"") || !str_contains(lt, "tm_scope: source.oo") {
        println("FAIL  languages.yml missing OODA entry");
        return 1;
    }
    println("PASS  languages.yml declares OODA (.oo/.oot, tm_scope source.oo)");
    let jr: Result[String, String] = oo_read_file(fs_r, root + "/linguist/grammars/oo.tmLanguage.json");
    let jt: String = match jr { Ok(s) => s, Err(_) => "" };
    let mut jb: List[Int] = list_new();
    let mut k: Int = 0;
    while k < bytes_len(jt) {
        jb = list_push(jb, byte_at(jt, k));
        k = k + 1;
    }
    let jend: Int = jzc_scan_value(jb, 0);
    let json_ok: Bool = jend > 0 && jzc_skip_ws(jb, jend) == list_len(jb);
    if !json_ok || !str_contains(jt, "\"scopeName\": \"source.oo\"") ||
        !str_contains(jt, "\"patterns\":") || !str_contains(jt, "\"repository\":") || !lv_regex_ok(jt) {
        println("FAIL  oo.tmLanguage.json invalid or unbalanced regex");
        return 1;
    }
    println("PASS  oo.tmLanguage.json parses as RFC 8259 JSON with balanced regexes");
    let ar: Result[String, String] = oo_read_file(fs_r, root + "/.gitattributes");
    let at: String = match ar { Ok(s) => s, Err(_) => "" };
    if !str_contains(at, "*.oo linguist-language=OODA") || !str_contains(at, "*.oot linguist-language=OODA") {
        println("FAIL  .gitattributes missing *.oo / *.oot OODA mapping");
        return 1;
    }
    println("PASS  .gitattributes maps *.oo and *.oot to OODA");
    return 0;
}

fn lv_rule_mask(src: String) -> Int {
    let mut m: Int = 0;
    let ls: List[String] = str_split(src, "\n");
    let mut i: Int = 0;
    while i < list_len(ls) {
        let t: String = str_trim(list_get(ls, i));
        if str_starts_with(t, "// #") || str_starts_with(t, "// Logline:") ||
            str_starts_with(t, "// Setup:") || str_starts_with(t, "// Beats:") ||
            str_starts_with(t, "// TYPESTATE") { m = m | 1; }
        if str_starts_with(t, "import ") && str_ends_with(t, ".oo\";") { m = m | 2; }
        if (str_starts_with(t, "fn ") || str_starts_with(t, "pub fn ")) && str_contains(t, "(") { m = m | 4; }
        if (str_starts_with(t, "type ") || str_starts_with(t, "pub type ")) && str_contains(t, " = ") { m = m | 8; }
        if str_starts_with(t, "requires ") || str_starts_with(t, "ensures ") ||
            str_starts_with(t, "invariant ") || str_starts_with(t, "decreases ") ||
            str_starts_with(t, "verify ") { m = m | 16; }
        if str_starts_with(t, "spec \"") { m = m | 32; }
        i = i + 1;
    }
    if str_contains(src, ": &") && str_contains(src, "Cap") { m = m | 64; }
    if str_contains(src, "-> Result[") || str_contains(src, "-> Option[") ||
        str_contains(src, "-> List[") { m = m | 128; }
    if str_contains(src, "oo_cap_") || str_contains(src, "rt_cap_") || str_contains(src, "oo_mmio_") ||
        str_contains(src, "rt_nostd_") || str_contains(src, "oo_alloc_") ||
        str_contains(src, "oo_read_") || str_contains(src, "oo_write_") { m = m | 256; }
    if str_contains(src, "oo_cap_reg64_") || str_contains(src, "oo_cap_bit_index_") ||
        str_contains(src, "oo_cap_pack(") || str_contains(src, "oo_cap_check(") ||
        str_contains(src, "oo_cap_attenuate(") || str_contains(src, "oo_cap_args_ok(") { m = m | 512; }
    return m;
}

fn lv_page_ok(src: String) -> Bool {
    let ls: List[String] = str_split(src, "\n");
    let mut nlines: Int = list_len(ls);
    if nlines > 0 && list_get(ls, nlines - 1) == "" { nlines = nlines - 1; }
    if nlines < 16 || nlines > 256 { return false; }
    let mut fns: Int = 0;
    let mut i: Int = 0;
    while i < list_len(ls) {
        let t: String = str_trim(list_get(ls, i));
        if str_starts_with(t, "fn ") || str_starts_with(t, "pub fn ") { fns = fns + 1; }
        i = i + 1;
    }
    return fns <= 8;
}

fn lv_list_samples(fs_r: &FsReadCap, sdir: String) -> List[String] {
    let raw: List[String] = oo_fs_read_dir(fs_r, sdir);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(raw) {
        let nm: String = list_get(raw, i);
        if str_ends_with(nm, ".oo") || str_ends_with(nm, ".oot") { out = list_push(out, nm); }
        i = i + 1;
    }
    let mut a: Int = 0;
    while a < list_len(out) {
        let mut b: Int = a + 1;
        while b < list_len(out) {
            let va: String = list_get(out, a);
            let vb: String = list_get(out, b);
            let mut k: Int = 0;
            let mut lim: Int = bytes_len(va);
            if bytes_len(vb) < lim { lim = bytes_len(vb); }
            let mut cmp: Int = bytes_len(vb) - bytes_len(va);
            while k < lim {
                let d: Int = byte_at(vb, k) - byte_at(va, k);
                if d != 0 {
                    cmp = d;
                    break;
                }
                k = k + 1;
            }
            if cmp < 0 {
                out = list_set(out, a, vb);
                out = list_set(out, b, va);
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return out;
}

fn lv_find_compiler(fs_r: &FsReadCap, env: &EnvCap) -> String {
    let ev: String = match env_get(env, "OODA_COMPILER") { Ok(s) => s, Err(_) => "" };
    if ev != "" && path_exists(fs_r, ev) { return ev; }
    let hm: String = match env_get(env, "HOME") { Ok(s) => s, Err(_) => "" };
    let cand: String = hm + "/.openooda/bin/ooda-compiler";
    if hm != "" && path_exists(fs_r, cand) { return cand; }
    return "";
}

fn lv_check_samples(fs_r: &FsReadCap, sys: &ProcessCap, comp: String, root: String) -> Int {
    let hr: Result[String, String] = oo_read_file(fs_r, root + "/linguist/heuristics.yml");
    let ht: String = match hr { Ok(s) => s, Err(_) => "" };
    let nrules: Int = list_len(str_split(ht, "language: OODA")) - 1;
    if !str_contains(ht, "\".oo\"") || !str_contains(ht, "\".oot\"") || nrules != 10 {
        println("FAIL  heuristics.yml missing expected 10 OODA rules");
        return 1;
    }
    let sdir: String = root + "/linguist/samples/OODA";
    let samples: List[String] = lv_list_samples(fs_r, sdir);
    if list_len(samples) < 8 {
        println("FAIL  too few sample files under " + sdir);
        return 1;
    }
    let mut fails: Int = 0;
    let mut corpus_mask: Int = 0;
    let mut i: Int = 0;
    while i < list_len(samples) {
        let nm: String = list_get(samples, i);
        let sp: String = sdir + "/" + nm;
        let src: String = match oo_read_file(fs_r, sp) { Ok(s) => s, Err(_) => "" };
        let rm: Int = lv_rule_mask(src);
        corpus_mask = corpus_mask | rm;
        if rm == 0 || !lv_page_ok(src) {
            println("FAIL  sample classification or Page Rule failed: " + nm);
            fails = fails + 1;
        }
        let argv: List[String] = list_push(list_push(list_new(), "check"), sp);
        let ck: Result[Int, String] = sys_exec_wait(sys, comp, argv);
        let rc: Int = match ck { Ok(c) => c, Err(_) => 1 };
        if rc != 0 {
            println("FAIL  ooda-compiler check " + nm);
            fails = fails + 1;
        } else {
            println("PASS  " + nm + ": heuristics + Page Rule + ooda-compiler check OK");
        }
        i = i + 1;
    }
    if corpus_mask != 1023 {
        println("FAIL  heuristics corpus mask incomplete: " + corpus_mask.to_string());
        fails = fails + 1;
    }
    return fails;
}

pub fn main(fs_r: &FsReadCap, sys: &ProcessCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let root: String = if list_len(args) > 0 { list_get(args, 0) } else { "." };
    let mut bad_root: Bool = root == "";
    let mut k: Int = 0;
    while k + 1 < bytes_len(root) {
        if byte_at(root, k) == 46 && byte_at(root, k + 1) == 46 { bad_root = true; }
        k = k + 1;
    }
    if bad_root {
        println("FAIL  refused invalid root");
        return Ok(2);
    }
    let comp: String = lv_find_compiler(fs_r, env);
    if comp == "" {
        println("FAIL  ooda-compiler binary not found (set OODA_COMPILER)");
        return Ok(1);
    }
    let mut fails: Int = lv_check_configs(fs_r, root);
    fails = fails + lv_check_samples(fs_r, sys, comp, root);
    if fails == 0 {
        println("PASS  pure-.oo linguist gate: 0 warning(s), 0 failure(s)");
        return Ok(0);
    }
    println("FAIL  pure-.oo linguist gate: " + fails.to_string() + " failure(s)");
    return Ok(1);
}
