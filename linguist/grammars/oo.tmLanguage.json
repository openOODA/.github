{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OODA",
  "scopeName": "source.oo",
  "fileTypes": [
    "oo",
    "oot"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#contracts"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#capabilities"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.triple-slash.documentation.oo",
          "match": "///.*$"
        },
        {
          "name": "comment.line.directive.typestate.oo",
          "match": "//\\s*TYPESTATE\\b.*$"
        },
        {
          "name": "comment.line.double-slash.documentation.oo",
          "match": "//\\s*(#|Logline:|Setup:|Beats:).*$"
        },
        {
          "name": "comment.line.double-slash.oo",
          "match": "//.*$"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.oo",
          "match": "\\b(requires|ensures|invariant|decreases|spec|cap|verify)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.modifier.oo",
          "match": "\\b(pub|mut|const|extern|export)\\b"
        },
        {
          "name": "keyword.other.declaration.oo",
          "match": "\\b(fn|let|struct|enum|type|import|impl|trait|newtype|where|gpu)\\b"
        },
        {
          "name": "entity.name.function.declaration.oo",
          "match": "(?<=\\bfn\\s)[a-z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.declaration.oo",
          "match": "(?<=\\btype\\s)[A-Z][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oo",
          "match": "\\b(if|else|while|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "constant.language.boolean.oo",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.variant.oo",
          "match": "\\b(Ok|Err|Some|None)\\b"
        },
        {
          "name": "variable.language.wildcard.oo",
          "match": "\\b_\\b"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "support.type.capability.reference.oo",
          "match": "&[A-Z][A-Za-z0-9_]*Cap\\b"
        },
        {
          "name": "support.type.capability.oo",
          "match": "\\b(NetCap|ProcessCap|FsWriteCap|FsReadCap|SysCap|FsCap|TimeCap|RandCap|AllocCap|ArenaCap|FfiCap|MetricsCap|SignCap|MmioCap|DmaCap|IrqCap|PciCap|TlsCap|TcpCap|UdpCap|BindCap|AudioCap|CameraCap|UsbCap|HidCap|WindowCap|FrameCap|ThreadCap|GpuCap|EnvCap|CompilerReadCap|BlockCap|TpmCap|Cap|CapReg64|CapDescriptor256|CSpaceTable|CdtTree)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.oo",
          "match": "\\b(Int|Float|Bool|String|List|Result|Option|Void|f64|u8|u16|u32|u64|i8|i16|i32|i64)\\b"
        },
        {
          "name": "entity.name.type.oo",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oo",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.oo",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.oo",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.oo",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.oo",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.oo",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.oo",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.oo",
          "match": "(\\.\\.=|\\.\\.|->|=>|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%&|^!<>=?:@])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "entity.name.function.macro.oo",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*!)"
        },
        {
          "name": "support.function.builtin.oo",
          "match": "\\b(println|process_exit|panic|assert|assert_eq|list_len|list_new|list_push|list_get|chars_len|char_at|str_slice|mk_raw|hex_decode)(?=\\s*\\()"
        },
        {
          "name": "support.function.runtime.oo",
          "match": "\\b(oo|rt)_[a-z0-9_]+(?=\\s*\\()"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.oo",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
