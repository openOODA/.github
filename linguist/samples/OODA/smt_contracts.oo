// # SMT requires/ensures Contract Sample
//
// Logline: Compile-time SMT contracts: requires preconditions, ensures postconditions on result, spec strings.
// Setup: Pure integer functions checked by the ahead-of-time QF_LIA solver; every clause is proved or refused before codegen.
// Beats:
//   1. requires narrows the legal input space (divisor > 0, lo <= hi, non-negative operands).
//   2. ensures binds the return value as result and states provable arithmetic facts.
//   3. spec records the solver fragment; verify_contracts.oo runs the negative-trust checks.

pub fn floor_div(num: Int, den: Int) -> Int
    requires num >= 0 && den > 0
    ensures result >= 0 && result * den <= num && num < (result + 1) * den
    spec "Floor division satisfies the Euclidean identity under QF_LIA"
{
    return num / den;
}

pub fn gcd(a: Int, b: Int) -> Int
    requires a >= 0 && b >= 0
    ensures result >= 0
    spec "Euclid gcd loop under QF_LIA contract"
{
    let mut x: Int = a;
    let mut y: Int = b;
    while y != 0 {
        let t: Int = y;
        y = x % y;
        x = t;
    }
    return x;
}

pub fn clamp(v: Int, lo: Int, hi: Int) -> Int
    requires lo <= hi
    ensures result >= lo && result <= hi
    spec "Saturate v into [lo, hi] under QF_LIA contract"
{
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

/// Halves x; covers the /// doc-comment and Float literal surfaces.
pub fn half(x: Float) -> Float {
    return x / 2.0;
}

pub fn checked_div(num: Int, den: Int) -> Result[Int, String] {
    if den == 0 { return Err("checked_div: divisor is zero"); }
    return Ok(num / den);
}
