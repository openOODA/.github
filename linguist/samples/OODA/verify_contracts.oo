// # verify + assert_eq! Compile-Time Contract Sample
//
// Logline: Check-time verify blocks carry assert_eq! negative-trust checks over the
//          sibling contract samples - a check-only page, never linked into a binary.
// Setup: verify/assert_eq! is the compile-time verification surface resolved by
//        `oodac check`; bodies run as OODA_TEST-gated ctors only where emit-safe.
// Beats:
//   1. capreg_gate_negative_trust refuses null, stale, wrong-cap, and wide-rights registers.
//   2. capreg_attenuate_monotone proves the child keeps FsRead and drops FsWrite.
//   3. smt_contracts_hold exercises the requires/ensures contract fns end to end.

import "capreg_attenuation.oo";
import "smt_contracts.oo";
import "typestate_machine.oo";
import "oostd/sec/capreg.oo";

pub fn verify_probe() -> Int {
    let caps: Int = 1 << oo_cap_bit_index("FsReadCap");
    let gate: Int = cap_admit(oo_cap_reg64_pack(7, 1, 1, caps), 7, 1);
    return gate + floor_div(18, 5) + gcd(12, 18) + clamp(7, 0, 5) + drive_link();
}

verify capreg_gate_negative_trust {
    let caps: Int = 1 << oo_cap_bit_index("FsReadCap");
    let reg64: Int = oo_cap_reg64_pack(7, 1, 1, caps);
    assert_eq!(cap_admit(reg64, 7, 1), 0);
    assert_eq!(cap_admit(0, 7, 1), -13);
    assert_eq!(cap_admit(reg64, 8, 1), -13);
    let net_caps: Int = 1 << oo_cap_bit_index("NetCap");
    let net_only: Int = oo_cap_reg64_pack(7, 1, 1, net_caps);
    assert_eq!(cap_admit(net_only, 7, 1), -13);
    assert_eq!(cap_admit(reg64, 7, 999), -22);
    assert_eq!(read_sector_gated(0, 7, 4), 0);
}

verify capreg_attenuate_monotone {
    let fsr: Int = 1 << oo_cap_bit_index("FsReadCap");
    let fsw: Int = 1 << oo_cap_bit_index("FsWriteCap");
    let both_caps: Int = fsr | fsw;
    let parent: Int = oo_cap_reg64_pack(7, 255, 1, both_caps);
    let child: Int = child_register(parent, 9);
    assert_eq!(oo_cap_reg64_check(child, 7, 1, fsr), true);
    assert_eq!(oo_cap_reg64_check(child, 7, 1, fsw), false);
}

verify smt_contracts_hold {
    assert_eq!(floor_div(17, 5), 3);
    assert_eq!(floor_div(0, 5), 0);
    assert_eq!(gcd(12, 18), 6);
    assert_eq!(clamp(7, 0, 5), 5);
    assert_eq!(clamp(3, 0, 5), 3);
    let r: Result[Int, String] = checked_div(10, 0);
    assert_eq!(r.is_err(), true);
    assert_eq!(drive_link(), 18);
}
