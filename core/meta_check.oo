// # .github Org Metadata Conformance Checker
//
// Logline: Verify the 5-org profile table, org links, and AGENTS.md census/member roster.
// Setup: Explicit FsReadCap for bounded profile and charter reads; fail closed.
// Beats:
//   1. meta_ver_num folds x.y.z semver digit runs like the constitutional card check.
//   2. meta_counts + meta_orgs verify the 5-org Repos/Packages cells and org links.
//   3. meta_census + meta_members verify the 65/69/74 totals and org member needles.

import "ooda-standard/core/primitives/str_extra.oo";
import "core/meta_law.oo";

pub fn meta_ver_num(ver: String) -> Int {
    let v: String = str_trim(ver);
    let parts: List[String] = str_split(v, ".");
    if list_len(parts) != 3 { return 0 - 1; }
    let mut i: Int = 0;
    let mut num: Int = 0;
    while i < 3 {
        let tok: String = list_get(parts, i);
        let tn: Int = bytes_len(tok);
        if tn == 0 || tn > 3 { return 0 - 1; }
        let mut j: Int = 0;
        while j < tn {
            let b: Int = byte_at(tok, j);
            if b < 48 || b > 57 { return 0 - 1; }
            j = j + 1;
        }
        num = num * 1000 + parse_int_digits(tok);
        i = i + 1;
    }
    return num;
}

pub fn meta_counts(src: String) -> Int {
    let mut n: Int = 0;
    if str_contains(src, "| `5` |") { n = n + 1; }
    if str_contains(src, "| `12` |") { n = n + 1; }
    if str_contains(src, "| `27` |") { n = n + 1; }
    if str_contains(src, "| `20` |") { n = n + 1; }
    if str_contains(src, "| `10` |") { n = n + 1; }
    return n;
}

pub fn meta_census(src: String) -> Int {
    let mut n: Int = 0;
    if str_contains(src, "`65`") { n = n + 1; }
    if str_contains(src, "`69`") { n = n + 1; }
    if str_contains(src, "`74`") { n = n + 1; }
    if str_contains(src, "`11`") { n = n + 1; }
    if str_contains(src, "`26`") { n = n + 1; }
    return n;
}

pub fn meta_orgs(src: String) -> Int {
    let mut n: Int = 0;
    if str_contains(src, "github.com/openOODA)") { n = n + 1; }
    if str_contains(src, "github.com/openOODA-core)") { n = n + 1; }
    if str_contains(src, "github.com/openOODA-system)") { n = n + 1; }
    if str_contains(src, "github.com/openOODA-apps)") { n = n + 1; }
    if str_contains(src, "github.com/openOODA-games)") { n = n + 1; }
    return n;
}

pub fn meta_members(src: String) -> Int {
    let mut n: Int = 0;
    if str_contains(src, "`openOODA`") { n = n + 1; }
    if str_contains(src, "ooda-compiler") { n = n + 1; }
    if str_contains(src, "ooda-shell") { n = n + 1; }
    if str_contains(src, "ooda-browser") { n = n + 1; }
    if str_contains(src, "ooda-engine") { n = n + 1; }
    return n;
}

pub fn meta_profile_ok(fs: &FsReadCap) -> Bool {
    let r: Result[String, String] = oo_read_file(fs, "profile/README.md");
    if r.is_err() { return false; }
    let src: String = match r { Ok(s) => s, Err(_) => "" };
    if !meta_shape(src) { return false; }
    if meta_counts(src) != 5 { return false; }
    if meta_orgs(src) != 5 { return false; }
    if !str_contains(src, "| `4` |") || !str_contains(src, "| `11` |") { return false; }
    if !str_contains(src, "| `26` |") || !str_contains(src, "| `19` |") { return false; }
    return str_contains(src, "| `9` |");
}

pub fn meta_charter_ok(fs: &FsReadCap) -> Bool {
    let ar: Result[String, String] = oo_read_file(fs, "AGENTS.md");
    if ar.is_err() { return false; }
    let ag: String = match ar { Ok(s) => s, Err(_) => "" };
    let sec: List[String] = str_split(ag, "## The Exact Consolidated 5-Organization Ecosystem");
    if list_len(sec) < 2 { return false; }
    let body: String = list_get(str_split(list_get(sec, 1), "\n## "), 0);
    if !str_contains(body, "**Fleet Census**:") || meta_counts(body) != 5 { return false; }
    return meta_census(body) == 5 && meta_members(body) == 5;
}

pub fn meta_repo_ok(fs: &FsReadCap) -> Bool {
    if !meta_profile_ok(fs) { return false; }
    if !meta_charter_ok(fs) { return false; }
    return meta_law_ok(fs);
}
