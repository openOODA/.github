// # oogithub Metadata Verbs - check/audit/status/census/about/theme Renderers
//
// Logline: Render the self-verification verbs over the real repository tree - every
//          verdict comes from core/meta_check.oo + core/meta_law.oo; zero stubs,
//          zero host relays.
// Setup: Explicit FsReadCap + EnvCap; oostd ootheme palette resolves the theme verb.
// Beats:
//   1. oogithub_report runs the full metadata verdict (profile+root+brand+linguist+docs).
//   2. oogithub_status prints the folded PASS/FAIL; oogithub_census lists the 9 orgs.
//   3. oogithub_about prints the canonical binary card; oogithub_theme resolves palettes.

import "core/meta_check.oo";
import "core/meta_law.oo";
import "cli/component.oo";
import "oostd/fs/process/env.oo";
import "oostd/core/app/ui/ootheme.oo";

pub fn oogithub_report(fs: &FsReadCap, json: Bool, deep: Bool) -> Int {
    let ver: String = oogithub_version();
    let p_ok: Bool = meta_profile_ok(fs);
    let r_ok: Bool = meta_root_ok(fs);
    let b_ok: Bool = meta_brand_ok(fs);
    let l_ok: Bool = meta_linguist_ok(fs);
    let d_ok: Bool = meta_docs_ok(fs);
    let ok: Bool = p_ok && r_ok && b_ok && l_ok && d_ok;
    if json {
        let jp: String = if ok { "true" } else { "false" };
        println("{\"component\":\"oogithub\",\"check\":\"verify\",\"version\":\"" + ver +
            "\",\"profile\":" + (if p_ok { "true" } else { "false" }) +
            ",\"root\":" + (if r_ok { "true" } else { "false" }) +
            ",\"brand\":" + (if b_ok { "true" } else { "false" }) +
            ",\"linguist\":" + (if l_ok { "true" } else { "false" }) +
            ",\"docs\":" + (if d_ok { "true" } else { "false" }) +
            ",\"pass\":" + jp + "}");
        return if ok { 0 } else { 1 };
    }
    if deep {
        println("  census: Root @openOODA = 5 governance repos (openOODA catalog install website .github)");
        println("  census: L0 @openOODA-core = 8, L1 @openOODA-kernel = 8, L2 @openOODA-OS = 9");
        println("  census: L3 @openOODA-tools = 39, L4 @openOODA-DE = 8, L5 @openOODA-apps = 16");
        println("  census: L6 @openOODA-cloud = 8, L7 @openOODA-agents = 9");
        println("  census: 97 product binaries L1-L7 / 105 L0-L7 / 110 total repos");
    }
    println("oogithub check (v" + ver + ")");
    println("  profile  : org table + census 97/105/110 " + (if p_ok { "ok" } else { "FAIL" }));
    println("  root     : 11 metadata entries " + (if r_ok { "ok" } else { "FAIL" }));
    println("  brand    : 56 org icons on disk " + (if b_ok { "ok" } else { "FAIL" }));
    println("  linguist : OODA package + 9 samples " + (if l_ok { "ok" } else { "FAIL" }));
    println("  docs     : AGENTS title + README links " + (if d_ok { "ok" } else { "FAIL" }));
    if ok {
        println("verify OK (all metadata invariants hold)");
        return 0;
    }
    println("verify FAIL (metadata invariants violated)");
    return 1;
}

pub fn oogithub_status(fs: &FsReadCap) -> Int {
    if meta_repo_ok(fs) {
        println("oogithub status: PASS (metadata verdict holds)");
        return 0;
    }
    println("oogithub status: FAIL (metadata verdict violated)");
    return 1;
}

pub fn oogithub_census(fs: &FsReadCap) -> Int {
    let r: Result[String, String] = oo_read_file(fs, "profile/README.md");
    if r.is_err() {
        println("oogithub census: FAIL (profile unreadable)");
        return 1;
    }
    let src: String = match r { Ok(s) => s, Err(_) => "" };
    if meta_counts(src) != 5 || meta_orgs(src) != 9 || meta_members(src) != 9 {
        println("oogithub census: FAIL (org table drifted from canonical census)");
        return 1;
    }
    println("  Root @openOODA         = 5   (openOODA catalog install website .github)");
    println("  L0   @openOODA-core    = 8   (ooda oodac oodar oostd oopm oolsp oomcp oohat)");
    println("  L1   @openOODA-kernel  = 8   (ooboot oohal ookernel + 5 oodrv suites)");
    println("  L2   @openOODA-OS      = 9   (ooinit oovfs oonetd + 6 daemons)");
    println("  L3   @openOODA-tools   = 39  (oodefense oosandbox ootheme ooui ooengine ...)");
    println("  L4   @openOODA-DE      = 8   (oocomp oopanel+ooagent-hud ooportal ooterm ...)");
    println("  L5   @openOODA-apps    = 16  (oobrowser oostudio oooffice oocanvas ...)");
    println("  L6   @openOODA-cloud   = 8   (oomesh oostore oodeploy oogateway ...)");
    println("  L7   @openOODA-agents  = 9   (ooloop ooswarm oobench oogovern+ooquota ...)");
    println("  97 product binaries L1-L7 / 105 L0-L7 / 110 total repos");
    return 0;
}

pub fn oogithub_about() -> Int {
    println("Binary       : oogithub (v" + oogithub_version() + ")");
    println("Organization : openOODA (https://github.com/openOODA/.github)");
    println("Summary      : Organization profile & governance metadata - census, brand & linguist verification");
    println("Subcommands  : check,audit,status,verify,census,theme,about,--self-test");
    println("Capabilities : FsRead,Env");
    println("Census       : 97 product binaries L1-L7, 105 L0-L7, 110 total repos (5 governance)");
    return 0;
}

pub fn oogithub_theme(env: &EnvCap, args: List[String], ver: String) -> Int {
    let mut tn: String = "";
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_starts_with(a, "--tui=") { tn = str_slice(a, 6, chars_len(a)); }
        if (a == "--tui" || a == "theme") && i + 1 < list_len(args) &&
            !str_starts_with(list_get(args, i + 1), "-") {
            tn = list_get(args, i + 1);
        }
        i = i + 1;
    }
    if tn == "" {
        let et: String = match env_get(env, "OODA_THEME") { Ok(s) => str_trim(s), Err(_) => "" };
        if et != "" && ootheme_known(et) { tn = et; }
    }
    if tn == "" {
        let nc: String = match env_get(env, "NO_COLOR") { Ok(s) => str_trim(s), Err(_) => "" };
        if nc != "" { tn = "no-color"; }
    }
    if tn == "" { tn = "ooda-dark"; }
    if !ootheme_known(tn) {
        println("oogithub " + ver + ": unknown theme " + tn);
        return 2;
    }
    let p: OoThemePalette = ootheme_resolve(tn);
    if !ootheme_verify(p) {
        println("oogithub " + ver + ": theme checksum failed");
        return 1;
    }
    println(ootheme_tui_frame(p, "oogithub", ver, "Root", "pass"));
    return 0;
}

pub fn oogithub_help(ver: String) -> Int {
    println("oogithub " + ver + " - openOODA org profile & governance metadata self-verification");
    println("usage: oogithub <verb> [.] [--json]");
    println("verbs: check|audit|status|verify  census  theme <name>  about");
    println("flags: --help --version --self-test --json (additive verdict envelope)");
    println("refusals: --persona/--mode/--personas, unknown arguments, '..' operands -> exit 2");
    return 0;
}
